# ==========================================
# TriageSync Environment Variables Template
# ==========================================

# Backend Configuration (Port 5001 avoids macOS AirPlay collision on 5000)
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triagesync?schema=public

# Authentication (JWT: 24-hour max lifespan requirement)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h

# Frontend Configuration (Vite requires VITE_ prefix for client-exposed variables)
VITE_API_BASE_URL=http://localhost:5001/api
