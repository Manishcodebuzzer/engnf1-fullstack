# Server Environment Configuration (Port 5001 avoids macOS AirPlay port 5000 conflict)
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triagesync?schema=public

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_long
JWT_EXPIRES_IN=7d
