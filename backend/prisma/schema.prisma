// Prisma Schema for TriageSync
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  USER
  ADMIN
}

enum TicketCategory {
  BILLING
  BUG
  FEATURE_REQUEST
  LOGIN
  DELIVERY
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketEventField {
  category
  priority
  status
  assigneeId
}

enum ResourceType {
  ROOM
  LAB
  EQUIPMENT
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())

  // Relationships
  assignedTickets Ticket[]  @relation("TicketAssignee")
  bookings        Booking[]

  @@index([email])
  @@index([role])
}

model Ticket {
  id              String         @id @default(uuid())
  externalId      String         @unique
  subject         String
  body            String         @db.Text
  autoCategory    TicketCategory
  category        TicketCategory
  isHumanOverride Boolean        @default(false)
  priority        TicketPriority
  status          TicketStatus   @default(OPEN)
  assigneeId      String?
  isReviewed      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relationships
  assignee User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events   TicketEvent[]
  bookings Booking[]

  // Indexes for high-performance triage querying and filtering
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([isReviewed])
}

model TicketEvent {
  id        String           @id @default(uuid())
  ticketId  String
  field     TicketEventField
  oldValue  String?
  newValue  String?
  actor     String
  createdAt DateTime         @default(now())

  // Relationships
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Indexes for timeline and audit history retrieval
  @@index([ticketId])
  @@index([createdAt])
}

model Resource {
  id          String       @id @default(uuid())
  name        String       @unique
  type        ResourceType
  capacity    Int
  description String?      @db.Text
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  // Relationships
  bookings Booking[]

  // Indexes for resource lookup and availability filtering
  @@index([name])
  @@index([type])
  @@index([isActive])
}

model Booking {
  id           String        @id @default(uuid())
  resourceId   String
  userId       String
  ticketId     String?
  startTime    DateTime
  endTime      DateTime
  purpose      String        @db.Text
  status       BookingStatus @default(PENDING)
  decisionNote String?       @db.Text
  createdAt    DateTime      @default(now())

  // Relationships
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket   Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  // Indexes for conflict detection and schedule queries
  @@index([resourceId, startTime, endTime])
  @@index([userId])
  @@index([ticketId])
  @@index([status])
  @@index([startTime, endTime])
}
